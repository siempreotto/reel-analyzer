{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reel-analyzer analysis.json",
  "type": "object",
  "required": ["version", "modo", "meta", "hook", "escenas", "ritmo", "audio_global", "transcripcion", "cuadros", "avisos"],
  "properties": {
    "version": {"type": "string"},
    "modo": {"enum": ["rapido", "completo"]},
    "meta": {
      "type": "object",
      "required": ["plataforma", "cuenta", "url", "duracion_s", "vistas", "likes", "caption"],
      "properties": {
        "plataforma": {"type": "string"},
        "id": {"type": "string"},
        "cuenta": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "titulo": {"type": ["string", "null"]},
        "fecha": {"type": ["string", "null"]},
        "duracion_s": {"type": "number", "minimum": 0},
        "vistas": {"type": ["integer", "null"]},
        "likes": {"type": ["integer", "null"]},
        "comentarios": {"type": ["integer", "null"]},
        "caption": {"type": ["string", "null"]},
        "resolucion": {"type": "string"},
        "orientacion": {"type": "string"},
        "procesado_en_s": {"type": "number"}
      }
    },
    "hook": {
      "type": "object",
      "required": ["t_fin", "frames", "voz", "texto_pantalla"],
      "properties": {
        "t_fin": {"type": "number"},
        "frames": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "voz": {"type": "string"},
        "texto_pantalla": {"type": ["string", "null"]},
        "loudness_lufs": {"type": ["number", "null"]},
        "cortes_en_hook": {"type": "integer"}
      }
    },
    "escenas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "t_inicio", "t_fin", "frames", "voz", "texto_pantalla", "audio"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "t_inicio": {"type": "number", "minimum": 0},
          "t_fin": {"type": "number"},
          "dur_s": {"type": "number"},
          "frames": {"type": "array", "items": {"type": "string"}},
          "voz": {"type": "string"},
          "texto_pantalla": {"type": ["string", "null"]},
          "audio": {
            "type": "object",
            "required": ["loudness_lufs", "silencio"],
            "properties": {
              "loudness_lufs": {"type": ["number", "null"]},
              "silencio": {"type": "boolean"},
              "energia_db": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "ritmo": {
      "type": "object",
      "required": ["cortes", "cortes_por_min", "toma_promedio_s"],
      "properties": {
        "cortes": {"type": "integer", "minimum": 0},
        "cortes_por_min": {"type": "number", "minimum": 0},
        "toma_promedio_s": {"type": "number", "minimum": 0},
        "toma_mas_corta_s": {"type": "number"},
        "toma_mas_larga_s": {"type": "number"},
        "palabras_por_min": {"type": ["number", "null"]},
        "tipo_probable": {"type": "string"}
      }
    },
    "audio_global": {
      "type": "object",
      "required": ["lufs_integrado", "silencios", "musica_probable"],
      "properties": {
        "tiene_audio": {"type": "boolean"},
        "lufs_integrado": {"type": ["number", "null"]},
        "rango_lra": {"type": ["number", "null"]},
        "silencios": {"type": "array"},
        "musica_probable": {"type": ["boolean", "null"]},
        "energia_db_por_segundo": {"type": "array", "items": {"type": "number"}}
      }
    },
    "transcripcion": {
      "type": ["object", "null"],
      "properties": {
        "fuente": {"enum": ["subtitulos", "whisper"]},
        "idioma": {"type": ["string", "null"]},
        "segmentos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "text"],
            "properties": {"start": {"type": "number"}, "end": {"type": "number"}, "text": {"type": "string"},
                           "palabras": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3}}}
          }
        }
      }
    },
    "cuadros": {
      "type": "object",
      "required": ["total", "tokens_estimados"],
      "properties": {
        "total": {"type": "integer"},
        "lado_largo_px": {"type": "integer"},
        "tokens_estimados": {"type": "integer"},
        "lista": {"type": "array", "items": {"type": "string"}}
      }
    },
    "avisos": {"type": "array", "items": {"type": "string"}}
  }
}
